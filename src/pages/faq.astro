---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : base + '/';
const contactHref = `${b}contact/`;

const faqCategories = [
  {
    heading: 'The Basics',
    items: [
      {
        q: 'Are you licensed and insured?',
        a: 'Yes — fully licensed in New Jersey (NJ Home Improvement Contractor License #13VH10743600) and carrying general liability and workers compensation insurance. We provide proof on request before any job starts.',
      },
      {
        q: 'What areas do you serve?',
        a: 'Our home base is Kearny, NJ. We regularly work in Harrison, Bloomfield, Nutley, Belleville, Lyndhurst, North Arlington, Rutherford, East Newark, and surrounding Hudson, Essex, and Bergen county towns. If you\'re within 30 minutes of Kearny, we can probably help.',
      },
      {
        q: 'How do your estimates work — is there a charge?',
        a: 'Estimates are always free. We visit the property, inspect the work, and follow up with a written, itemized quote — usually within 24–48 hours. No obligation, no sales pressure.',
      },
      {
        q: 'Do you offer financing?',
        a: 'Financing options vary by project size. Ask us during your estimate visit and we\'ll walk you through what\'s currently available.',
      },
    ],
  },
  {
    heading: 'Roofing',
    items: [
      {
        q: 'How long does a typical roof replacement take?',
        a: 'Most residential asphalt shingle roof replacements are completed in 1–3 days, depending on square footage and weather. We coordinate dump service and clean up thoroughly each evening.',
      },
      {
        q: 'Do you handle insurance claims for storm or wind damage?',
        a: 'Yes. We regularly work with homeowners and their adjusters on storm damage claims — documenting the damage, meeting the adjuster on site, and repairing to spec.',
      },
      {
        q: 'What shingle brands do you install?',
        a: 'We primarily install GAF, Owens Corning, and CertainTeed asphalt shingles — all major manufacturers with strong warranties. We\'ll recommend the right product for your home and budget during the estimate.',
      },
    ],
  },
  {
    heading: 'Siding, Windows & Gutters',
    items: [
      {
        q: 'What siding materials do you work with?',
        a: 'Vinyl (including insulated vinyl) and fiber cement panels are our specialties. Both are low-maintenance, weather-resistant, and appropriate for New Jersey climate conditions.',
      },
      {
        q: 'Will new windows really lower my energy bill?',
        a: 'In most older NJ homes, yes — noticeably. Modern double- and triple-pane Low-E glass cuts heat loss in winter and heat gain in summer. We can help you compare payback periods during the estimate.',
      },
      {
        q: 'Do I need new gutters or can mine be repaired?',
        a: 'If the gutter is sagging, pulling away from the fascia, or has separated at the seams, repair is usually a patch at best. For seamless aluminum systems, full replacement is typically the better value.',
      },
    ],
  },
  {
    heading: 'Warranty & After the Job',
    items: [
      {
        q: 'What warranty do you offer on your work?',
        a: 'Every installation is backed by a labor warranty on top of the manufacturer warranty on materials (which varies by product — typically 25–50 years on shingles, 20+ on siding). Details are included in every contract.',
      },
      {
        q: 'What if something goes wrong after the job?',
        a: 'Call us. We answer the phone. If it\'s warranty-covered work, we come back and fix it. That\'s it.',
      },
      {
        q: 'Do you clean up after the work?',
        a: 'Yes — dump service is coordinated, we clean daily, and we sweep the lawn and driveway with magnets to pick up stray nails. You shouldn\'t be able to tell we were there except for the new roof (or siding, or gutters).',
      },
    ],
  },
];
---

<Layout
  title="FAQ | JustMel LLC — Common Questions About Our Work"
  description="Straight answers about licensing, timelines, warranties, and how JustMel LLC handles roofing, siding, window, and gutter projects in northern New Jersey."
>
  <PageHero
    eyebrow="FAQ"
    title="Straight Answers to the Questions We Hear Most."
    subtitle="No industry jargon, no sales speak. If your question isn't here, call us at 973-698-0608 and ask."
    breadcrumb="FAQ"
  />

  <section class="faq-page section">
    <div class="container">
      {faqCategories.map((cat, ci) => (
        <div class={`faq-group reveal reveal-delay-${(ci % 3) + 1}`}>
          <h2 class="faq-group-heading">{cat.heading}</h2>
          <div class="faq-list">
            {cat.items.map((f, i) => (
              <details class="faq-item" open={ci === 0 && i === 0}>
                <summary>
                  <span>{f.q}</span>
                  <span class="faq-toggle">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </span>
                </summary>
                <div class="faq-answer">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <div class="faq-contact reveal">
        <h3>Still have a question?</h3>
        <p>We're happy to walk you through anything we didn't cover. No obligation, no sales pressure.</p>
        <div class="faq-contact-cta">
          <a href={contactHref} class="btn btn-primary">Ask Us Directly</a>
          <a href="tel:+19736980608" class="btn btn-dark">Call 973-698-0608</a>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</Layout>

<style>
  .faq-page {
    background: var(--white);
  }

  .faq-group {
    margin-bottom: 3rem;
  }

  .faq-group-heading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--teal-dark);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--gray-100);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--off-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--gray-100);
    transition: all 0.25s ease;
  }

  .faq-item[open] {
    border-color: var(--teal);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.5rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--navy-deep);
    user-select: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-toggle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(79, 182, 196, 0.12);
    color: var(--teal-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .faq-item[open] .faq-toggle {
    transform: rotate(45deg);
    background: var(--teal);
    color: var(--white);
  }

  .faq-answer {
    padding: 0 1.5rem 1.35rem;
  }

  .faq-answer p {
    color: var(--gray-700);
    line-height: 1.7;
    font-size: 0.96rem;
    margin: 0;
  }

  .faq-contact {
    background: var(--off-white);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    text-align: center;
    border: 1px solid var(--gray-100);
    margin-top: 2rem;
  }

  .faq-contact h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .faq-contact p {
    color: var(--gray-700);
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }

  .faq-contact-cta {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

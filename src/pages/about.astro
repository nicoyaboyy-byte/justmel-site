---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import CTABand from '../components/CTABand.astro';

const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : base + '/';
const contactHref = `${b}contact/`;

const values = [
  {
    title: 'Do it right the first time.',
    body: 'We install to manufacturer spec — not "close enough." That means proper flashing, ice & water shield, house wrap, and fasteners that belong on the job.',
  },
  {
    title: 'Show up when we say we will.',
    body: 'Our day starts on time. If weather shifts a schedule, you hear about it from us before you have to call and ask.',
  },
  {
    title: 'Communicate like a neighbor, not a salesperson.',
    body: 'No high-pressure quotes, no bait-and-switch. We walk the property, explain what you need, and leave a written quote so you can think it over.',
  },
  {
    title: 'Stand behind the work in writing.',
    body: 'Every job carries a labor warranty on top of the manufacturer\'s material warranty. It\'s in the contract.',
  },
];

const timeline = [
  { year: '2009', milestone: 'JustMel LLC founded in Kearny, NJ by Mel and family.' },
  { year: '2012', milestone: 'Licensed NJ Home Improvement Contractor #13VH10743600.' },
  { year: '2015', milestone: 'Expanded full-time roofing and siding crews.' },
  { year: '2019', milestone: 'Added windows and seamless gutter installation in-house.' },
  { year: '2024+', milestone: 'Serving hundreds of homes across Hudson, Essex, and Bergen counties.' },
];
---

<Layout
  title="About | JustMel LLC — Family-Run Contractor in Kearny, NJ"
  description="JustMel LLC is a family-run general contractor based in Kearny, New Jersey. Licensed #13VH10743600, fully insured, and trusted by homeowners across northern NJ since 2009."
>
  <PageHero
    eyebrow="About JustMel"
    title="A Family-Run Crew You'd Trust Next Door."
    subtitle="We're not a national chain. We're a local, licensed general contractor that does roofing, siding, windows, and gutters — and does them right."
    breadcrumb="About"
  />

  <About />

  <section class="values section">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">How We Work</span>
        <h2>Four Principles We Won't Compromise On.</h2>
        <p>The shortcuts other contractors take are the same shortcuts that cost homeowners money in year three. Here's what we do instead.</p>
      </div>

      <div class="values-grid">
        {values.map((v, i) => (
          <article class={`value-card reveal reveal-delay-${(i % 2) + 1}`}>
            <span class="value-num">0{i + 1}</span>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="timeline section">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Our Story</span>
        <h2>Built, Year by Year, in Northern NJ.</h2>
      </div>

      <div class="timeline-list reveal">
        {timeline.map((t) => (
          <div class="timeline-item">
            <span class="timeline-year">{t.year}</span>
            <div class="timeline-dot"></div>
            <p>{t.milestone}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="about-cta-section section">
    <div class="container about-cta-inner reveal">
      <h2>Want to work with a crew that actually cares?</h2>
      <p>Call us, text us, or request a free estimate online. We respond same-day, Mon&ndash;Sat.</p>
      <div class="cta-buttons">
        <a href={contactHref} class="btn btn-primary">Get a Free Estimate</a>
        <a href="tel:+19736980608" class="btn btn-dark">Call 973-698-0608</a>
      </div>
    </div>
  </section>

  <CTABand />
</Layout>

<style>
  .values {
    background: var(--off-white);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    border: 1px solid var(--gray-100);
    position: relative;
    transition: all 0.3s var(--ease-out);
  }

  .value-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: transparent;
    transform: translateY(-4px);
  }

  .value-num {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--teal);
    line-height: 1;
    letter-spacing: -0.03em;
    display: block;
    margin-bottom: 0.75rem;
  }

  .value-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
  }

  .value-card p {
    color: var(--gray-700);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .values-grid { grid-template-columns: 1fr; }
  }

  .timeline {
    background: var(--white);
  }

  .timeline-list {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    padding-left: 2rem;
    border-left: 2px solid var(--gray-100);
  }

  .timeline-item {
    position: relative;
    padding: 1.25rem 0 1.25rem 1.75rem;
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .timeline-dot {
    position: absolute;
    left: -2.375rem;
    top: 1.75rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--teal);
    border: 3px solid var(--white);
    box-shadow: 0 0 0 2px var(--teal);
  }

  .timeline-year {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--navy-deep);
    letter-spacing: 0.02em;
  }

  .timeline-item p {
    color: var(--gray-700);
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 600px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }

  .about-cta-section {
    background: var(--off-white);
  }

  .about-cta-inner {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }

  .about-cta-inner h2 {
    margin-bottom: 1rem;
  }

  .about-cta-inner p {
    font-size: 1.05rem;
    color: var(--gray-700);
    margin-bottom: 1.75rem;
  }

  .cta-buttons {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

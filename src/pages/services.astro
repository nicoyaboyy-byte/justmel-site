---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Services from '../components/Services.astro';
import CTABand from '../components/CTABand.astro';

const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : base + '/';
const contactHref = `${b}contact/`;
const galleryHref = `${b}gallery/`;

const detailedServices = [
  {
    title: 'Roofing',
    tag: 'Shingles · Flat · Repair',
    blurb: 'We tear off, replace, and repair asphalt shingle roofs across northern New Jersey. Every job includes full underlayment, proper flashing, ridge venting, and a clean-up that leaves your property spotless.',
    bullets: [
      'Full roof replacement (tear-off)',
      'Leak investigation & targeted repair',
      'Flashing, chimney, and skylight work',
      'Ice & water shield + synthetic underlayment',
      'Ridge + soffit ventilation upgrades',
    ],
    icon: 'roofing',
  },
  {
    title: 'Siding',
    tag: 'Vinyl · Fiber Cement',
    blurb: 'Vinyl and fiber-cement siding installed to manufacturer spec with house wrap, proper flashing around windows and doors, and trim that actually lines up. Boost curb appeal and seal your home from the weather in a single pass.',
    bullets: [
      'Full re-side (old siding tear-off included)',
      'Insulated vinyl for better energy performance',
      'Fiber cement / James Hardie-style panels',
      'Trim, fascia, and soffit replacement',
      'Color-matched caulking & finish details',
    ],
    icon: 'siding',
  },
  {
    title: 'Windows',
    tag: 'Energy Efficient · Custom',
    blurb: 'Replacement windows that quiet your home, cut your heating bill, and look sharp from the curb. We fit double-hung, casement, slider, and picture windows — custom sized, properly sealed, and finished inside and out.',
    bullets: [
      'Full-frame and insert installations',
      'Double- and triple-pane Low-E glass',
      'Custom sizing for older NJ homes',
      'Interior & exterior trim finishing',
      'Old window removal and disposal',
    ],
    icon: 'windows',
  },
  {
    title: 'Gutters',
    tag: 'Seamless · Leaf Guards',
    blurb: 'Seamless aluminum gutter systems cut on-site to exact lengths, pitched properly, and hung on hidden hangers so they last. Downspouts routed away from your foundation — the whole point of the system.',
    bullets: [
      'Seamless 5" and 6" aluminum',
      'Downspout routing & splash blocks',
      'Leaf guard / gutter screen systems',
      'Fascia board repair when needed',
      'Gutter cleaning & maintenance',
    ],
    icon: 'gutters',
  },
];

const whyUs = [
  { title: 'Licensed & Insured', blurb: 'NJ HIC #13VH10743600. Full general liability and workers comp. Proof on request.' },
  { title: 'In-House Crew', blurb: 'Never subcontracted. The crew on your property is the crew we hired and trained.' },
  { title: 'Written Warranties', blurb: 'Labor warranty on every install, stacked on top of the manufacturer material warranty.' },
  { title: 'Clean Job Sites', blurb: 'Dump service coordinated, daily clean-up, and a magnet sweep for nails before we leave.' },
  { title: 'Free Estimates', blurb: 'We walk the property, listen, and send a written itemized quote within 24–48 hours.' },
  { title: 'Local to Kearny', blurb: 'Based in Kearny, NJ — we work Hudson, Essex, and Bergen county every week.' },
];
---

<Layout
  title="Services | JustMel LLC — Roofing, Siding, Windows, Gutters in Northern NJ"
  description="Full-service exterior contracting in Kearny, NJ. Roofing, siding, window replacement, and seamless gutter installation. Licensed NJ HIC #13VH10743600, fully insured."
>
  <PageHero
    eyebrow="Our Services"
    title="Four Specialties. One Crew. Built to Last."
    subtitle="We stick to what we're excellent at — roofing, siding, windows, and gutters — so every JustMel project is done right, on time, and warrantied in writing."
    breadcrumb="Services"
  />

  <Services />

  <section class="detail section">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">The Work, In Detail</span>
        <h2>What You Actually Get With Each Service</h2>
        <p>Here's exactly what's included when you hire JustMel for any of our four specialties.</p>
      </div>

      <div class="detail-list">
        {detailedServices.map((s, i) => (
          <article class={`detail-card reveal`}>
            <div class="detail-media">
              <div class="detail-gradient">
                <svg viewBox="0 0 200 140" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id={`dg-${i}`} x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#1a2b5c"/>
                      <stop offset="1" stop-color="#2a8d9a"/>
                    </linearGradient>
                  </defs>
                  <rect width="200" height="140" fill={`url(#dg-${i})`}/>
                  <path d="M30 95 L100 45 L170 95 L170 130 L30 130 Z" fill="rgba(255,255,255,0.95)"/>
                  <path d="M100 45 L170 95 L170 60 L140 40 Z" fill="#4fb6c4"/>
                  <rect x="55" y="100" width="22" height="26" fill="#0a1228"/>
                  <rect x="90" y="100" width="32" height="20" fill="#0a1228"/>
                  <rect x="135" y="100" width="20" height="26" fill="#0a1228"/>
                </svg>
              </div>
              <span class="detail-num">0{i + 1}</span>
            </div>
            <div class="detail-body">
              <span class="detail-tag">{s.tag}</span>
              <h3>{s.title}</h3>
              <p>{s.blurb}</p>
              <ul>
                {s.bullets.map((bullet) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <a href={contactHref} class="btn btn-primary btn-sm">Get a Quote for {s.title}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="why section">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Why JustMel</span>
        <h2>The Standards We Won't Cut Corners On.</h2>
      </div>

      <div class="why-grid">
        {whyUs.map((w, i) => (
          <article class={`why-card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="why-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 12 14 16 10"/></svg>
            </div>
            <h4>{w.title}</h4>
            <p>{w.blurb}</p>
          </article>
        ))}
      </div>

      <div class="why-cta reveal">
        <a href={contactHref} class="btn btn-primary">Request a Free Estimate</a>
        <a href={galleryHref} class="btn btn-ghost">See Recent Work</a>
      </div>
    </div>
  </section>

  <CTABand />
</Layout>

<style>
  .detail {
    background: var(--off-white);
  }

  .detail-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .detail-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2.5rem;
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.35s var(--ease-out);
  }

  .detail-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .detail-media {
    position: relative;
  }

  .detail-gradient {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .detail-gradient svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .detail-num {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1;
  }

  .detail-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--teal-dark);
    margin-bottom: 0.5rem;
  }

  .detail-body h3 {
    font-size: 1.8rem;
    margin-bottom: 0.75rem;
  }

  .detail-body > p {
    margin-bottom: 1.25rem;
    color: var(--gray-700);
  }

  .detail-body ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .detail-body li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.92rem;
    color: var(--gray-700);
  }

  .detail-body li svg {
    color: var(--teal-dark);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  @media (max-width: 820px) {
    .detail-card {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .detail-body ul {
      grid-template-columns: 1fr;
    }
  }

  .why {
    background: var(--white);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .why-card {
    background: var(--off-white);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
    border: 1px solid var(--gray-100);
    transition: all 0.3s var(--ease-out);
  }

  .why-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }

  .why-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(79, 182, 196, 0.12);
    color: var(--teal-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .why-card h4 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--navy-deep);
  }

  .why-card p {
    font-size: 0.93rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  .why-cta {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 540px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>

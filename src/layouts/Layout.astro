---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'JustMel LLC | General Contractor in Kearny, NJ — Siding, Roofing, Windows, Gutters',
  description = 'Fully insured general contractor serving Kearny, NJ and surrounding areas. Expert siding, roofing, window, and gutter installation. Licensed #13VH10743600. Free estimates — call 973-698-0608.',
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content="general contractor Kearny NJ, siding installation, roofing contractor, window replacement, gutter installation, licensed contractor New Jersey" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

---
const faqs = [
  {
    q: 'How long does a typical roof replacement take?',
    a: 'Most residential asphalt shingle roof replacements are completed in 1–3 days, depending on square footage and weather. We coordinate dump service and clean up thoroughly each evening.',
  },
  {
    q: 'Are you licensed and insured?',
    a: 'Yes — fully licensed in New Jersey (NJ Home Improvement Contractor License #13VH10743600) and carrying general liability and workers compensation insurance. We provide proof on request before any job starts.',
  },
  {
    q: 'Do you handle insurance claims for storm or wind damage?',
    a: 'Yes. We regularly work with homeowners and their adjusters on storm damage claims — documenting the damage, meeting the adjuster on site, and repairing to spec.',
  },
  {
    q: 'What areas do you serve?',
    a: 'Our home base is Kearny, NJ. We regularly work in Harrison, Bloomfield, Nutley, Belleville, Lyndhurst, North Arlington, and surrounding Hudson, Essex, and Bergen county towns.',
  },
  {
    q: 'How do your estimates work — is there a charge?',
    a: 'Estimates are always free. We visit the property, inspect the work, and follow up with a written, itemized quote — usually within 24–48 hours. No obligation, no sales pressure.',
  },
  {
    q: 'What warranty do you offer on your work?',
    a: 'Every installation is backed by a labor warranty on top of the manufacturer warranty on materials (which varies by product — typically 25–50 years on shingles, 20+ on siding). Details are included in every contract.',
  },
];

const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : base + '/';
const contactHref = `${b}contact/`;
---

<section class="faq section" id="faq">
  <div class="container faq-inner">
    <div class="faq-intro reveal-left">
      <span class="eyebrow">Frequently Asked</span>
      <h2>Answers to the Questions<br/>We Hear Most.</h2>
      <p>
        Straight answers about timelines, licensing, insurance, warranties, and
        how we work. If your question isn't here, call us and ask — we'll tell it
        to you straight.
      </p>
      <a href={contactHref} class="btn btn-dark">Ask a Question</a>
    </div>

    <div class="faq-list reveal-right">
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="faq-toggle">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--off-white);
  }

  .faq-inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .faq-intro {
    position: sticky;
    top: 160px;
  }

  .faq-intro h2 {
    margin-bottom: 1.25rem;
    margin-top: 0.5rem;
  }

  .faq-intro p {
    margin-bottom: 2rem;
    font-size: 1rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--teal);
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--navy-deep);
    list-style: none;
    transition: color 0.2s ease;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover {
    color: var(--teal-dark);
  }

  .faq-toggle {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--teal-dark);
    background: var(--teal-light);
    border-radius: 50%;
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-toggle {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.35rem;
  }

  .faq-answer p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--gray-600);
  }

  @media (max-width: 900px) {
    .faq-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .faq-intro {
      position: static;
    }
  }
</style>

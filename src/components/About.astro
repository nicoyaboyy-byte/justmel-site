---
const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : base + '/';
const contactHref = `${b}contact/`;
const galleryHref = `${b}gallery/`;
const aboutImg = `${b}images/about/yardsign.jpg`;
---

<section class="about section" id="about">
  <div class="container about-grid">
    <div class="about-media reveal-left">
      <div class="media-frame">
        <div class="media-photo" style={`background-image: url('${aboutImg}');`}></div>

        <div class="media-badge">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 12 14 16 10"/></svg>
          <div>
            <strong>Licensed &amp; Insured</strong>
            <span>NJ HIC #13VH10743600</span>
          </div>
        </div>
      </div>
    </div>

    <div class="about-content reveal-right">
      <span class="eyebrow">About JustMel LLC</span>
      <h2>Transforming Houses into Homes You'll Be Proud Of.</h2>
      <p class="lead">
        JustMel LLC is a family-run general contractor based in Kearny, New Jersey.
        We specialize in the four exterior services that matter most — roofing,
        siding, windows, and gutters — and we do them with the kind of care and
        craftsmanship homeowners actually recommend to their neighbors.
      </p>
      <p>
        Every project is handled start-to-finish by our own crew. We show up on
        time, work clean, communicate clearly, and stand behind every install
        with a written warranty. That's the standard.
      </p>

      <div class="stats-row">
        <div class="stat">
          <span class="stat-num"><span data-count="15" data-suffix="+">0+</span></span>
          <span class="stat-label">Years of Experience</span>
        </div>
        <div class="stat">
          <span class="stat-num"><span data-count="500" data-suffix="+">0+</span></span>
          <span class="stat-label">Happy Homeowners</span>
        </div>
        <div class="stat">
          <span class="stat-num"><span data-count="100" data-suffix="%">0%</span></span>
          <span class="stat-label">Licensed &amp; Insured</span>
        </div>
      </div>

      <div class="about-cta">
        <a href={contactHref} class="btn btn-dark">Schedule an Estimate</a>
        <a href={galleryHref} class="btn btn-ghost">See Our Work</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4.5rem;
    align-items: center;
  }

  .about-media {
    position: relative;
  }

  .media-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: visible;
  }

  .media-photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    aspect-ratio: 4 / 5;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .media-badge {
    position: absolute;
    bottom: -1.25rem;
    right: -1.25rem;
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--teal-dark);
    max-width: 270px;
  }

  .media-badge strong {
    display: block;
    font-family: var(--font-display);
    color: var(--navy-deep);
    font-size: 0.95rem;
    margin-bottom: 0.15rem;
  }

  .media-badge span {
    font-size: 0.78rem;
    color: var(--gray-400);
    letter-spacing: 0.04em;
  }

  .about-content .lead {
    font-size: 1.1rem;
    color: var(--gray-700);
    margin-top: 1rem;
    margin-bottom: 1rem;
    line-height: 1.75;
  }

  .about-content > p {
    margin-bottom: 2.5rem;
    font-size: 0.97rem;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid var(--gray-100);
    border-bottom: 1px solid var(--gray-100);
    margin-bottom: 2.5rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--teal-dark);
    line-height: 1;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--gray-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .about-cta {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .about-media {
      max-width: 440px;
      margin: 0 auto;
    }
    .media-badge {
      right: 1rem;
      bottom: -0.75rem;
    }
    .stats-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
  }

  @media (max-width: 500px) {
    .stat-num { font-size: 1.75rem; }
    .stat-label { font-size: 0.7rem; }
  }
</style>

---
const testimonials = [
  {
    quote: "The JustMel crew replaced our roof and gutters in three days. Clean, on schedule, and the price matched the quote exactly. Couldn't recommend them more.",
    name: "Maria R.",
    project: "Roof & Gutter Replacement",
    loc: "Kearny, NJ",
  },
  {
    quote: "I got three quotes for new siding. JustMel wasn't the cheapest, but their communication and workmanship were in a different league. Absolutely worth it.",
    name: "David C.",
    project: "Full Siding Install",
    loc: "Harrison, NJ",
  },
  {
    quote: "Fast, honest, and detail-oriented. They caught a rotten sheathing issue two other contractors missed before re-roofing. Real professionals.",
    name: "Jennifer L.",
    project: "Full Roof Replacement",
    loc: "Belleville, NJ",
  },
];
---

<section class="testimonials section">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">What Homeowners Say</span>
      <h2>Trusted by Homeowners<br/>Across Northern New Jersey</h2>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((t, i) => (
        <blockquote class={`testimonial reveal reveal-delay-${i + 1}`}>
          <svg class="quote-mark" viewBox="0 0 24 24" fill="currentColor"><path d="M7.17 11.17C6.52 11.06 6 10.48 6 9.78V7a1 1 0 0 1 1-1h3.17a1 1 0 0 1 1 1v5.22c0 2.3-1.62 4.78-4.17 5.28a1 1 0 0 1-1-1v-1.61c1.83-.39 2.5-1.78 2.5-3.28-.11.11-.22.28-.33.56zm9 0C15.52 11.06 15 10.48 15 9.78V7a1 1 0 0 1 1-1h3.17a1 1 0 0 1 1 1v5.22c0 2.3-1.62 4.78-4.17 5.28a1 1 0 0 1-1-1v-1.61c1.83-.39 2.5-1.78 2.5-3.28-.11.11-.22.28-.33.56z"/></svg>
          <div class="stars">
            {[1, 2, 3, 4, 5].map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            ))}
          </div>
          <p class="quote">{t.quote}</p>
          <footer>
            <div class="avatar">{t.name.split(' ').map((n) => n[0]).join('')}</div>
            <div>
              <cite>{t.name}</cite>
              <span class="meta">{t.project} · {t.loc}</span>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--white);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .testimonial {
    position: relative;
    background: var(--off-white);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    border: 1px solid var(--gray-100);
    transition: all 0.3s var(--ease-out);
  }

  .testimonial:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--teal-light);
  }

  .quote-mark {
    width: 36px;
    height: 36px;
    color: var(--teal);
    opacity: 0.25;
    margin-bottom: 0.5rem;
  }

  .stars {
    display: flex;
    gap: 2px;
    color: #f0b429;
    margin-bottom: 1rem;
  }

  .quote {
    font-size: 1rem;
    color: var(--gray-700);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .testimonial footer {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gray-100);
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--navy) 0%, var(--teal) 100%);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  cite {
    display: block;
    font-style: normal;
    font-weight: 600;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--navy-deep);
  }

  .meta {
    font-size: 0.78rem;
    color: var(--gray-400);
  }

  @media (max-width: 900px) {
    .testimonials-grid { grid-template-columns: 1fr; }
  }
</style>

---
const testimonials = [
  {
    quote: "The JustMel crew replaced our roof and gutters in three days. Clean, professional, and the price was exactly what they quoted. Couldn't recommend more.",
    name: "Maria R.",
    project: "Roof & Gutter Replacement · Kearny, NJ",
  },
  {
    quote: "I got three quotes for new siding and windows. JustMel wasn't the cheapest, but their communication and workmanship were a different league. Worth every penny.",
    name: "David C.",
    project: "Siding & Windows · Harrison, NJ",
  },
  {
    quote: "Fast, honest, and detail-oriented. They caught a rotten sheathing issue before re-roofing that two other contractors missed. Real pros.",
    name: "Jennifer L.",
    project: "Full Roof Replacement · Belleville, NJ",
  },
];
---

<section class="testimonials section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">What Homeowners Say</span>
      <h2>Reviews That Speak for the Work</h2>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((t) => (
        <blockquote class="testimonial">
          <div class="stars">
            {[1, 2, 3, 4, 5].map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            ))}
          </div>
          <p class="quote">"{t.quote}"</p>
          <footer>
            <cite class="author">{t.name}</cite>
            <span class="project">{t.project}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--white);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .testimonial {
    background: var(--off-white);
    border-radius: var(--radius-lg);
    padding: 2rem;
    border-left: 4px solid var(--teal);
    position: relative;
  }

  .stars {
    display: flex;
    gap: 2px;
    color: #f0b429;
    margin-bottom: 1rem;
  }

  .quote {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--navy-deep);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  .testimonial footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .author {
    font-style: normal;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--navy-deep);
  }

  .project {
    font-size: 0.82rem;
    color: var(--gray-400);
  }
</style>

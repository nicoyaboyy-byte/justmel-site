---
const phoneLink = 'tel:+19736980608';
const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : base + '/';
const contactHref = `${b}contact/`;
---

<section class="cta-band">
  <div class="cta-bg"></div>
  <div class="container cta-inner reveal-zoom">
    <div class="cta-text">
      <span class="eyebrow">Ready to Start?</span>
      <h2>Protect Your Biggest Investment<br/>with Work Built to Last.</h2>
    </div>
    <div class="cta-actions">
      <a href={contactHref} class="btn btn-primary">Contact Us Now</a>
      <a href={phoneLink} class="btn btn-outline">973-698-0608</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    padding: 5rem 0;
    color: var(--white);
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 40%, rgba(79, 182, 196, 0.25) 0%, transparent 50%),
      radial-gradient(circle at 80% 60%, rgba(10, 18, 40, 0.4) 0%, transparent 60%),
      linear-gradient(135deg, var(--navy-deep) 0%, var(--navy) 55%, var(--teal-dark) 100%);
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 30 L30 0 L60 30 L60 60 L0 60 Z' fill='none' stroke='%23ffffff' stroke-width='1' opacity='0.05'/%3E%3C/svg%3E");
  }

  .cta-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .cta-text h2 {
    color: var(--white);
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    line-height: 1.2;
  }

  .cta-text .eyebrow {
    color: var(--teal);
  }

  .cta-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .cta-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

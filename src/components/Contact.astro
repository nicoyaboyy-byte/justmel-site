---
const phone = '973-698-0608';
const phoneLink = 'tel:+19736980608';
const whatsappLink = 'https://wa.me/19736980608?text=Hi%20JustMel%2C%20I%27m%20interested%20in%20a%20free%20estimate.';
---

<section class="contact section" id="contact">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <span class="eyebrow">Get in Touch</span>
        <h2>Ready for a Free Estimate?</h2>
        <p>
          Call or message us — most quotes are scheduled within 24–48 hours.
          We'll walk your property, answer your questions, and give you a clear,
          written price. No pressure, no obligation.
        </p>

        <div class="contact-methods">
          <a href={phoneLink} class="contact-method">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <span class="method-label">Call Direct</span>
              <strong>{phone}</strong>
            </div>
          </a>

          <a href={whatsappLink} target="_blank" rel="noopener" class="contact-method">
            <div class="method-icon whatsapp">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            </div>
            <div>
              <span class="method-label">Message on WhatsApp</span>
              <strong>Fast, easy quote requests</strong>
            </div>
          </a>

          <div class="contact-method static">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <span class="method-label">Service Area</span>
              <strong>Kearny, NJ &amp; Surrounding</strong>
            </div>
          </div>

          <div class="contact-method static">
            <div class="method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
              <span class="method-label">Hours</span>
              <strong>Mon–Sat · 7:00am – 6:00pm</strong>
            </div>
          </div>
        </div>
      </div>

      <form class="contact-form" onsubmit="event.preventDefault(); alert('Form not yet connected. Please call or message via WhatsApp for now.');">
        <h3>Request a Free Estimate</h3>
        <p class="form-sub">Fill this out and we'll call you back — usually same day.</p>

        <div class="field">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" required placeholder="John Smith" />
        </div>

        <div class="field-row">
          <div class="field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" required placeholder="(973) 555-0123" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" />
          </div>
        </div>

        <div class="field">
          <label for="service">Service Needed</label>
          <select id="service" name="service">
            <option value="">Select one…</option>
            <option>Siding</option>
            <option>Roofing</option>
            <option>Windows</option>
            <option>Gutters</option>
            <option>Multiple / Not Sure</option>
          </select>
        </div>

        <div class="field">
          <label for="message">Tell us about your project</label>
          <textarea id="message" name="message" rows="4" placeholder="Project details, timeline, property address…"></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-full">
          Send My Request
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>

        <p class="form-disclaimer">
          By submitting you agree to be contacted about your project. We never share your info.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--off-white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-info h2 {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .contact-info > p {
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: var(--radius);
    transition: all 0.2s ease;
    color: var(--ink);
  }

  a.contact-method:hover {
    border-color: var(--teal);
    transform: translateX(4px);
    box-shadow: var(--shadow-sm);
  }

  .contact-method.static {
    cursor: default;
  }

  .method-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .method-icon svg {
    width: 20px;
    height: 20px;
  }

  .method-icon.whatsapp {
    background: #25d366;
  }

  .method-label {
    display: block;
    font-size: 0.78rem;
    color: var(--gray-400);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.15rem;
  }

  .contact-method strong {
    font-size: 1.05rem;
    color: var(--navy-deep);
    font-weight: 600;
  }

  .contact-form {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .contact-form h3 {
    margin-bottom: 0.4rem;
  }

  .form-sub {
    color: var(--gray-600);
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .field {
    margin-bottom: 1.25rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navy-deep);
    margin-bottom: 0.4rem;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    transition: border-color 0.2s ease;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(79, 182, 196, 0.15);
  }

  .field textarea {
    resize: vertical;
    font-family: var(--font-sans);
  }

  .btn-full {
    width: 100%;
    margin-top: 0.5rem;
  }

  .form-disclaimer {
    font-size: 0.78rem;
    color: var(--gray-400);
    text-align: center;
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 500px) {
    .field-row {
      grid-template-columns: 1fr;
    }
    .contact-form {
      padding: 1.75rem;
    }
  }
</style>

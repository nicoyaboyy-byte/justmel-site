---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : base + '/';
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <div class="footer-brand-mark">
        <div class="footer-brand-icon">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 36 L32 14 L56 36 L56 58 L8 58 Z" fill="#ffffff" opacity="0.95"/>
            <path d="M32 14 L56 36 L56 22 L44 14 Z" fill="#4fb6c4"/>
            <rect x="20" y="40" width="10" height="14" fill="#0a1228"/>
            <rect x="36" y="40" width="10" height="10" fill="#0a1228"/>
          </svg>
        </div>
        <div>
          <span class="footer-name">JUSTMEL LLC</span>
          <span class="footer-subname">General Contractor</span>
        </div>
      </div>
      <p class="brand-tag">Transforming houses into homes you'll be proud of — licensed, insured, and trusted across northern New Jersey.</p>
      <div class="footer-license">
        <span class="license-badge">Fully Insured</span>
        <span class="license-badge">NJ HIC #13VH10743600</span>
      </div>
    </div>

    <div class="footer-col">
      <h4>Services</h4>
      <ul>
        <li><a href={`${b}services/`}>Roofing</a></li>
        <li><a href={`${b}services/`}>Siding</a></li>
        <li><a href={`${b}services/`}>Windows</a></li>
        <li><a href={`${b}services/`}>Gutters</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Company</h4>
      <ul>
        <li><a href={`${b}about/`}>About Us</a></li>
        <li><a href={`${b}gallery/`}>Gallery</a></li>
        <li><a href={`${b}faq/`}>FAQ</a></li>
        <li><a href={`${b}contact/`}>Contact</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Get In Touch</h4>
      <ul>
        <li><a href="tel:+19736980608">973-698-0608</a></li>
        <li><a href="https://wa.me/19736980608" target="_blank" rel="noopener">WhatsApp Us</a></li>
        <li>Kearny, NJ</li>
        <li>Mon&ndash;Sat · 7am&ndash;6pm</li>
      </ul>
      <div class="footer-social">
        <a href="#" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/></svg></a>
        <a href="#" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
        <a href="#" aria-label="Google"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg></a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {year} JustMel LLC. All rights reserved.</p>
      <p class="credit">Quality exterior work across northern New Jersey.</p>
      <a href="#top" class="back-to-top" aria-label="Back to top">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-deep);
    color: rgba(255, 255, 255, 0.7);
    padding-top: 4.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-brand-mark {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .footer-brand-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }

  .footer-brand-icon svg {
    width: 100%;
    height: 100%;
  }

  .footer-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .footer-subname {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    color: #4fb6c4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-top: 0.3rem;
  }

  .brand-tag {
    font-size: 0.92rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 1.5rem;
    max-width: 340px;
  }

  .footer-license {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .license-badge {
    background: rgba(79, 182, 196, 0.15);
    color: var(--teal);
    padding: 0.4rem 0.85rem;
    border-radius: 3px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid rgba(79, 182, 196, 0.25);
  }

  .footer-col h4 {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer-col a,
  .footer-col li {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--teal);
  }

  .footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .footer-social a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    transition: all 0.2s ease;
  }

  .footer-social a:hover {
    background: var(--teal);
    color: var(--white);
    transform: translateY(-2px);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.5rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer-bottom-inner p {
    color: inherit;
    margin: 0;
  }

  .back-to-top {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--teal);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .back-to-top:hover {
    background: var(--teal-dark);
    color: var(--white);
    transform: translateY(-3px);
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 500px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>

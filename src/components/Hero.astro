---
const phoneLink = 'tel:+19736980608';
---

<section class="hero" id="top">
  <div class="hero-bg"></div>

  <div class="container hero-inner">
    <div class="hero-text reveal">
      <span class="eyebrow hero-eyebrow">Licensed · Insured · Kearny, NJ</span>
      <h1>
        Quality Exteriors,<br />
        <span class="accent">Built to Last.</span>
      </h1>
      <p class="hero-lead">
        JustMel LLC is a family-trusted general contractor specializing in
        roofing, siding, windows, and gutters. Quality craftsmanship homeowners
        across northern New Jersey count on — fully licensed and insured.
      </p>
      <div class="hero-ctas">
        <a href="#contact" class="btn btn-primary">Free Estimate</a>
        <a href={phoneLink} class="btn btn-outline">Call 973-698-0608</a>
      </div>
    </div>

    <ul class="hero-stats">
      <li><strong><span data-count="15" data-suffix="+">0+</span></strong><span>Years Serving NJ</span></li>
      <li><strong><span data-count="500" data-suffix="+">0+</span></strong><span>Happy Homeowners</span></li>
      <li><strong>100%</strong><span>Licensed &amp; Insured</span></li>
      <li><strong>Free</strong><span>On-Site Estimates</span></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 7rem 0 5rem;
    color: #ffffff;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    background:
      radial-gradient(circle at 15% 25%, rgba(79, 182, 196, 0.22) 0%, transparent 45%),
      radial-gradient(circle at 85% 75%, rgba(26, 43, 92, 0.4) 0%, transparent 55%),
      linear-gradient(135deg, #0a1228 0%, #1a2b5c 55%, #2a8d9a 100%);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 40 L40 0 L80 40 L80 80 L0 80 Z' fill='none' stroke='%23ffffff' stroke-width='1' opacity='0.06'/%3E%3C/svg%3E");
    opacity: 0.5;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
  }

  .hero-text {
    max-width: 760px;
    text-align: center;
    margin: 0 auto 4rem;
  }

  .hero-eyebrow {
    color: #4fb6c4;
  }

  .hero h1 {
    color: #ffffff;
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
  }

  .hero h1 .accent {
    color: #4fb6c4;
    font-style: italic;
    font-weight: 600;
  }

  .hero-lead {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.1rem;
    max-width: 620px;
    margin: 0 auto 2.25rem;
    line-height: 1.65;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  .hero-stats {
    list-style: none;
    margin: 0;
    padding: 2.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-stats li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: #4fb6c4;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-stats span {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4.5rem 0 3.5rem;
    }
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .hero-stats strong {
      font-size: 1.75rem;
    }
  }
</style>

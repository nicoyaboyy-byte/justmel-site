---
const phoneLink = 'tel:+19736980608';
const whatsappLink = 'https://wa.me/19736980608?text=Hi%20JustMel%2C%20I%27m%20interested%20in%20a%20free%20estimate.';

const slides = [
  {
    eyebrow: 'Expert Exterior Craftsmanship',
    title: 'Roofs Built to<br/>Weather Any Storm',
    sub: 'Premium asphalt shingle installations backed by industry-leading warranties.',
    ctaPrimary: { label: 'Explore Services', href: '#services' },
    ctaSecondary: { label: 'Get a Free Estimate', href: '#contact' },
    bg: 'linear-gradient(135deg, #0a1228 0%, #1a2b5c 55%, #2a8d9a 100%)',
  },
  {
    eyebrow: 'Siding · Windows · Gutters',
    title: 'Clean Exteriors,<br/>Lasting Curb Appeal',
    sub: 'Vinyl & fiber cement siding, energy-efficient windows, seamless gutter systems.',
    ctaPrimary: { label: 'View Our Work', href: '#gallery' },
    ctaSecondary: { label: 'Call 973-698-0608', href: phoneLink },
    bg: 'linear-gradient(135deg, #0f1b3d 0%, #2a8d9a 60%, #4fb6c4 100%)',
  },
  {
    eyebrow: 'Licensed · Insured · Trusted',
    title: 'Your Home,<br/>In Expert Hands',
    sub: 'Fully licensed NJ contractor #13VH10743600 — serving Kearny and surrounding towns.',
    ctaPrimary: { label: 'Get Started', href: '#contact' },
    ctaSecondary: { label: 'Message on WhatsApp', href: whatsappLink },
    bg: 'linear-gradient(135deg, #1a2b5c 0%, #0a1228 55%, #1a2b5c 100%)',
  },
];
---

<section class="hero" id="top">
  <div class="slides" id="heroSlides">
    {slides.map((s, i) => (
      <div class={`slide ${i === 0 ? 'active' : ''}`} data-slide={i} style={`background: ${s.bg};`}>
        <div class="slide-overlay"></div>
        <div class="container slide-content">
          <div class="slide-text">
            <span class="eyebrow">{s.eyebrow}</span>
            <h1 set:html={s.title} />
            <p>{s.sub}</p>
            <div class="slide-ctas">
              <a href={s.ctaPrimary.href} class="btn btn-primary">{s.ctaPrimary.label}</a>
              <a href={s.ctaSecondary.href} class="btn btn-outline">{s.ctaSecondary.label}</a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="slide-nav">
    <button class="slide-arrow prev" id="prevSlide" aria-label="Previous slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="slide-dots" id="slideDots">
      {slides.map((_, i) => (
        <button class={`dot ${i === 0 ? 'active' : ''}`} data-dot={i} aria-label={`Go to slide ${i + 1}`}></button>
      ))}
    </div>
    <button class="slide-arrow next" id="nextSlide" aria-label="Next slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <a href="#services" class="scroll-indicator" aria-label="Scroll down">
    <span>Scroll</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: min(720px, 100vh);
    min-height: 580px;
    overflow: hidden;
    color: var(--white);
  }

  .slides {
    position: absolute;
    inset: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s var(--ease-out);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 25%, rgba(79, 182, 196, 0.25) 0%, transparent 40%),
      radial-gradient(circle at 85% 75%, rgba(26, 43, 92, 0.4) 0%, transparent 50%),
      linear-gradient(180deg, rgba(10, 18, 40, 0.35) 0%, rgba(10, 18, 40, 0.55) 100%);
  }

  .slide-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 40 L40 0 L80 40 L80 80 L0 80 Z' fill='none' stroke='%23ffffff' stroke-width='1' opacity='0.04'/%3E%3C/svg%3E");
  }

  .slide-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .slide-text {
    max-width: 680px;
  }

  .slide .eyebrow {
    color: var(--teal);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s 0.2s var(--ease-out), transform 0.8s 0.2s var(--ease-out);
  }

  .slide h1 {
    color: var(--white);
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.9s 0.35s var(--ease-out), transform 0.9s 0.35s var(--ease-out);
  }

  .slide p {
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.1rem;
    max-width: 540px;
    margin-bottom: 2.25rem;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.9s 0.5s var(--ease-out), transform 0.9s 0.5s var(--ease-out);
  }

  .slide-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.9s 0.65s var(--ease-out), transform 0.9s 0.65s var(--ease-out);
  }

  .slide.active .eyebrow,
  .slide.active h1,
  .slide.active p,
  .slide.active .slide-ctas {
    opacity: 1;
    transform: translateY(0);
  }

  .slide.active .eyebrow { opacity: 1; }

  .slide-nav {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .slide-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .slide-arrow:hover {
    background: var(--teal);
    border-color: var(--teal);
  }

  .slide-dots {
    display: flex;
    gap: 0.6rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition: all 0.25s ease;
    padding: 0;
  }

  .dot.active {
    background: var(--teal);
    transform: scale(1.25);
  }

  .scroll-indicator {
    position: absolute;
    right: 2rem;
    bottom: 2.5rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: bounce 2.5s infinite;
  }

  .scroll-indicator:hover {
    color: var(--teal);
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-8px); }
    60% { transform: translateY(-4px); }
  }

  @media (max-width: 768px) {
    .scroll-indicator {
      display: none;
    }
    .slide-nav {
      bottom: 1.5rem;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll('.slide');
  const dots = document.querySelectorAll<HTMLButtonElement>('.dot');
  const prev = document.getElementById('prevSlide');
  const next = document.getElementById('nextSlide');
  let current = 0;
  let autoInterval: ReturnType<typeof setInterval>;

  const go = (i: number) => {
    slides[current].classList.remove('active');
    dots[current]?.classList.remove('active');
    current = (i + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current]?.classList.add('active');
  };

  const restart = () => {
    clearInterval(autoInterval);
    autoInterval = setInterval(() => go(current + 1), 6500);
  };

  dots.forEach((d) => d.addEventListener('click', () => { go(parseInt(d.dataset.dot!, 10)); restart(); }));
  prev?.addEventListener('click', () => { go(current - 1); restart(); });
  next?.addEventListener('click', () => { go(current + 1); restart(); });

  restart();
</script>

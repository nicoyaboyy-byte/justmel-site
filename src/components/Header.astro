---
const phone = '973-698-0608';
const phoneLink = 'tel:+19736980608';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const base = import.meta.env.BASE_URL;
// normalize: ensure base ends with '/'
const b = base.endsWith('/') ? base : base + '/';

const nav = [
  { label: 'Home', href: b },
  { label: 'Services', href: `${b}services/` },
  { label: 'Gallery', href: `${b}gallery/` },
  { label: 'About', href: `${b}about/` },
  { label: 'FAQ', href: `${b}faq/` },
  { label: 'Contact', href: `${b}contact/` },
];

// Normalize current path (strip trailing slash for comparison, except root)
function isActive(href: string) {
  const cur = currentPath.replace(/\/$/, '') || '/';
  const target = href.replace(/\/$/, '') || '/';
  const baseNorm = b.replace(/\/$/, '') || '/';
  if (target === baseNorm) return cur === baseNorm;
  return cur === target || cur.startsWith(target + '/');
}

const contactHref = `${b}contact/`;
const estimateHref = `${b}contact/`;
---

<header class="header">
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-left">
        <a href={phoneLink} class="top-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {phone}
        </a>
        <span class="divider">•</span>
        <span class="top-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>Kearny, NJ</span>
        <span class="divider">•</span>
        <span class="top-item">Lic# 13VH10743600</span>
      </div>
      <div class="top-bar-right">
        <a href={contactHref} class="lets-talk">Let's Talk &rarr;</a>
      </div>
    </div>
  </div>

  <nav class="nav">
    <div class="container nav-inner">
      <a href={b} class="brand">
        <div class="brand-icon">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 36 L32 14 L56 36 L56 58 L8 58 Z" fill="#1a2b5c"/>
            <path d="M32 14 L56 36 L56 22 L44 14 Z" fill="#4fb6c4"/>
            <rect x="20" y="40" width="10" height="14" fill="#ffffff"/>
            <rect x="36" y="40" width="10" height="10" fill="#ffffff"/>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-name">JUSTMEL <span class="llc">LLC</span></span>
          <span class="brand-tagline">General Contractor</span>
        </div>
      </a>

      <ul class="nav-links">
        {nav.map((item) => (
          <li><a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a></li>
        ))}
      </ul>

      <div class="nav-cta">
        <a href={estimateHref} class="btn btn-primary btn-sm">Free Estimate</a>
      </div>

      <button class="menu-toggle" aria-label="Toggle menu" id="menuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="mobile-nav" id="mobileNav">
      {nav.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
      ))}
      <a href={estimateHref} class="btn btn-primary">Free Estimate</a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #ffffff;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
  }

  .top-bar {
    background: #0a1228;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.8rem;
  }

  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .top-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
  }

  a.top-item:hover {
    color: #4fb6c4;
  }

  .divider {
    color: rgba(255, 255, 255, 0.25);
  }

  .lets-talk {
    color: #4fb6c4;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .lets-talk:hover {
    color: #ffffff;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    gap: 2rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .brand-icon svg {
    width: 100%;
    height: 100%;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    color: #0a1228;
    letter-spacing: 0.01em;
  }

  .brand-name .llc {
    font-weight: 600;
    color: #4fb6c4;
  }

  .brand-tagline {
    font-size: 0.65rem;
    font-weight: 600;
    color: #8a94a6;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: #0a1228;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    background: #4fb6c4;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  .nav-links a:hover {
    color: #2a8d9a;
  }

  .nav-links a:hover::after,
  .nav-links a.active::after {
    transform: scaleX(1);
  }

  .nav-links a.active {
    color: #2a8d9a;
  }

  .btn-sm {
    padding: 0.7rem 1.4rem;
    font-size: 0.75rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .menu-toggle span {
    width: 24px;
    height: 2px;
    background: #0a1228;
    transition: all 0.2s ease;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    background: #ffffff;
    border-top: 1px solid #e8ecf1;
    padding: 1rem 1.5rem 1.5rem;
    gap: 0.5rem;
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-nav a {
    color: #0a1228;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #e8ecf1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mobile-nav a.active {
    color: #2a8d9a;
  }

  .mobile-nav a.btn {
    margin-top: 0.75rem;
    border-bottom: none;
    color: #ffffff;
    padding: 0.9rem;
  }

  @media (max-width: 980px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 700px) {
    .top-bar-left .divider:nth-of-type(n+2),
    .top-bar-left .top-item:nth-child(n+3) {
      display: none;
    }
    .brand-tagline {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menuToggle');
  const mobileNav = document.getElementById('mobileNav');
  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      mobileNav.classList.toggle('open');
    });
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => mobileNav.classList.remove('open'));
    });
  }
</script>

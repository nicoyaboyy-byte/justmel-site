---
const phone = '973-698-0608';
const phoneLink = 'tel:+19736980608';
const base = import.meta.env.BASE_URL;
---

<header class="header">
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-left">
        <a href={phoneLink} class="top-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {phone}
        </a>
        <span class="divider">•</span>
        <span class="top-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>Kearny, NJ</span>
        <span class="divider">•</span>
        <span class="top-item">Lic# 13VH10743600</span>
      </div>
      <div class="top-bar-right">
        <a href="#contact" class="lets-talk">Let's Talk &rarr;</a>
      </div>
    </div>
  </div>

  <nav class="nav">
    <div class="container nav-inner">
      <a href="#top" class="brand">
        <img src={`${base}images/logo.png`} alt="JustMel LLC General Contractor" />
      </a>

      <ul class="nav-links">
        <li><a href="#top">Home</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#gallery">Gallery</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>

      <div class="nav-cta">
        <a href="#contact" class="btn btn-primary btn-sm">Free Estimate</a>
      </div>

      <button class="menu-toggle" aria-label="Toggle menu" id="menuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="mobile-nav" id="mobileNav">
      <a href="#top">Home</a>
      <a href="#services">Services</a>
      <a href="#gallery">Gallery</a>
      <a href="#about">About</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
      <a href="#contact" class="btn btn-primary">Free Estimate</a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
  }

  .top-bar {
    background: var(--navy-deep);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.8rem;
  }

  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .top-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
  }

  a.top-item:hover {
    color: var(--teal);
  }

  .divider {
    color: rgba(255, 255, 255, 0.25);
  }

  .lets-talk {
    color: var(--teal);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .lets-talk:hover {
    color: var(--white);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
    gap: 2rem;
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .brand img {
    height: 64px;
    width: auto;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2.25rem;
  }

  .nav-links a {
    color: var(--navy-deep);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  .nav-links a:hover {
    color: var(--teal-dark);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
  }

  .btn-sm {
    padding: 0.7rem 1.4rem;
    font-size: 0.75rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .menu-toggle span {
    width: 24px;
    height: 2px;
    background: var(--navy-deep);
    transition: all 0.2s ease;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    background: var(--white);
    border-top: 1px solid var(--gray-100);
    padding: 1rem 1.5rem 1.5rem;
    gap: 0.5rem;
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-nav a {
    color: var(--navy-deep);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--gray-100);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mobile-nav a.btn {
    margin-top: 0.75rem;
    border-bottom: none;
    color: var(--white);
    padding: 0.9rem;
  }

  @media (max-width: 980px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .brand img {
      height: 52px;
    }
  }

  @media (max-width: 700px) {
    .top-bar-left .divider,
    .top-bar-left .top-item:nth-child(n+3) {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menuToggle');
  const mobileNav = document.getElementById('mobileNav');
  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      mobileNav.classList.toggle('open');
    });
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => mobileNav.classList.remove('open'));
    });
  }
</script>

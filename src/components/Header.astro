---
const phone = '973-698-0608';
const phoneLink = 'tel:+19736980608';
---

<header class="header">
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-left">
        <span class="badge">Fully Insured</span>
        <span class="divider">•</span>
        <span>Lic# 13VH10743600</span>
        <span class="divider">•</span>
        <span>Kearny, NJ</span>
      </div>
      <div class="top-bar-right">
        <a href={phoneLink} class="top-phone">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {phone}
        </a>
      </div>
    </div>
  </div>

  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <span class="brand-mark">JustMel</span>
        <span class="brand-sub">LLC · General Contractor</span>
      </a>

      <ul class="nav-links">
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#why">Why Us</a></li>
        <li><a href="#gallery">Gallery</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>

      <div class="nav-cta">
        <a href="#contact" class="btn btn-primary btn-sm">Get a Free Estimate</a>
      </div>

      <button class="menu-toggle" aria-label="Toggle menu" id="menuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="mobile-nav" id="mobileNav">
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#why">Why Us</a>
      <a href="#gallery">Gallery</a>
      <a href="#contact">Contact</a>
      <a href="#contact" class="btn btn-primary">Get a Free Estimate</a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .top-bar {
    background: var(--navy-deep);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.82rem;
  }

  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .badge {
    background: var(--teal);
    color: var(--white);
    padding: 0.15rem 0.6rem;
    border-radius: 3px;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .divider {
    color: rgba(255, 255, 255, 0.35);
  }

  .top-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--white);
    font-weight: 600;
  }

  .top-phone:hover {
    color: var(--teal);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    gap: 2rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-mark {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--navy-deep);
    letter-spacing: 0.01em;
  }

  .brand-sub {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--gray-400);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 0.3rem;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-links a {
    color: var(--navy-deep);
    font-weight: 500;
    font-size: 0.95rem;
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--teal);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
  }

  .btn-sm {
    padding: 0.65rem 1.25rem;
    font-size: 0.85rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .menu-toggle span {
    width: 24px;
    height: 2px;
    background: var(--navy-deep);
    transition: all 0.2s ease;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    background: var(--white);
    border-top: 1px solid var(--gray-100);
    padding: 1rem 1.5rem 1.5rem;
    gap: 0.5rem;
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-nav a {
    color: var(--navy-deep);
    font-weight: 500;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--gray-100);
  }

  .mobile-nav a.btn {
    margin-top: 0.75rem;
    border-bottom: none;
    color: var(--white);
    padding: 0.9rem;
  }

  @media (max-width: 900px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .top-bar-left .divider:nth-of-type(2),
    .top-bar-left span:last-child {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menuToggle');
  const mobileNav = document.getElementById('mobileNav');
  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      mobileNav.classList.toggle('open');
    });
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => mobileNav.classList.remove('open'));
    });
  }
</script>

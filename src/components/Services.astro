---
const services = [
  {
    title: 'Siding',
    blurb: 'Durable, weather-resistant siding in vinyl, fiber cement, and more — installed to protect your home and boost curb appeal for years to come.',
    bullets: ['Vinyl & fiber cement', 'Full tear-off & re-side', 'Insulated options'],
    icon: 'siding',
  },
  {
    title: 'Roofing',
    blurb: 'Professional roof installation and replacement using premium asphalt shingles and proven systems built to handle New Jersey weather.',
    bullets: ['Full roof replacement', 'Asphalt shingle specialists', 'Flashing & underlayment'],
    icon: 'roofing',
  },
  {
    title: 'Windows',
    blurb: 'Energy-efficient replacement windows that lower utility bills, reduce outside noise, and give your home a clean, modern finish.',
    bullets: ['Double & triple pane', 'Custom sizing', 'Low-E energy efficient'],
    icon: 'windows',
  },
  {
    title: 'Gutters',
    blurb: 'Seamless gutter installation and repair that keep water away from your foundation — precision-measured and professionally hung.',
    bullets: ['Seamless aluminum', 'Leaf guards available', 'Downspout systems'],
    icon: 'gutters',
  },
];
---

<section class="services section" id="services">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">What We Do</span>
      <h2>Exterior Services Done Right, the First Time</h2>
      <p>
        We focus on what we do best — the four exterior services that protect
        your home and define its curb appeal. Every job is handled by our in-house
        crew, never subcontracted out.
      </p>
    </div>

    <div class="services-grid">
      {services.map((s) => (
        <article class="service-card">
          <div class="service-icon" data-icon={s.icon}>
            {s.icon === 'siding' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 20h48M8 28h48M8 36h48M8 44h48"/><path d="M12 16v32M52 16v32M32 16v32"/></svg>
            )}
            {s.icon === 'roofing' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 34 32 12l26 22"/><path d="M12 32v18h40V32"/><path d="M24 50V38h16v12"/></svg>
            )}
            {s.icon === 'windows' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="12" y="10" width="40" height="44" rx="2"/><path d="M32 10v44M12 32h40"/></svg>
            )}
            {s.icon === 'gutters' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h56v8c0 2-2 4-4 4H8c-2 0-4-2-4-4z"/><path d="M14 32v20M50 32v20"/><path d="M12 52h6M48 52h6"/></svg>
            )}
          </div>
          <h3>{s.title}</h3>
          <p>{s.blurb}</p>
          <ul class="service-bullets">
            {s.bullets.map((b) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {b}
              </li>
            ))}
          </ul>
          <a href="#contact" class="service-link">
            Request a Quote
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--off-white);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .service-card {
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: var(--radius-lg);
    padding: 2.25rem 1.75rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--navy), var(--teal));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: transparent;
    box-shadow: var(--shadow-lg);
  }

  .service-card:hover::before {
    transform: scaleX(1);
  }

  .service-icon {
    width: 56px;
    height: 56px;
    color: var(--teal);
    margin-bottom: 1.25rem;
  }

  .service-icon svg {
    width: 100%;
    height: 100%;
  }

  .service-card h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .service-card > p {
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  .service-bullets {
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .service-bullets li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0;
    font-size: 0.9rem;
    color: var(--gray-600);
  }

  .service-bullets svg {
    color: var(--teal);
    flex-shrink: 0;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    color: var(--navy);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }

  .service-link:hover {
    color: var(--teal-dark);
    gap: 0.75rem;
  }

  .service-link svg {
    transition: transform 0.2s ease;
  }

  .service-link:hover svg {
    transform: translateX(3px);
  }
</style>

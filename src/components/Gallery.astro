---
const projects = [
  { category: 'Roofing', title: 'Asphalt Shingle Replacement', location: 'Kearny, NJ', color: '#1a2b5c' },
  { category: 'Siding', title: 'Vinyl Siding Install', location: 'Harrison, NJ', color: '#4fb6c4' },
  { category: 'Windows', title: 'Full Window Replacement', location: 'North Arlington, NJ', color: '#2a8d9a' },
  { category: 'Gutters', title: 'Seamless Gutter System', location: 'Belleville, NJ', color: '#1a2b5c' },
  { category: 'Siding', title: 'Fiber Cement Siding', location: 'Nutley, NJ', color: '#4fb6c4' },
  { category: 'Roofing', title: 'Complete Roof Tear-Off', location: 'Lyndhurst, NJ', color: '#2a8d9a' },
];
---

<section class="gallery section" id="gallery">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Recent Work</span>
      <h2>Projects We're Proud Of</h2>
      <p>
        A small sample of the exterior transformations we've completed across
        northern New Jersey. More photos are added as projects wrap up.
      </p>
    </div>

    <div class="gallery-grid">
      {projects.map((p, i) => (
        <figure class={`gallery-item gallery-item-${i + 1}`}>
          <div class="gallery-image" style={`background: linear-gradient(135deg, ${p.color} 0%, ${p.color}dd 100%);`}>
            <svg viewBox="0 0 100 100" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5">
              <path d="M10 70 L50 35 L90 70 L90 90 L10 90 Z"/>
              <path d="M50 35 L50 90"/>
              <path d="M30 90 L30 70"/>
              <path d="M70 90 L70 70"/>
            </svg>
          </div>
          <figcaption>
            <span class="project-category">{p.category}</span>
            <h4>{p.title}</h4>
            <span class="project-location">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {p.location}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="gallery-cta">
      <p>Want to see more? Ask for project references on your estimate visit.</p>
      <a href="#contact" class="btn btn-ghost">Schedule an Estimate</a>
    </div>
  </div>
</section>

<style>
  .gallery {
    background: var(--off-white);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .gallery-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .gallery-image {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .gallery-image svg {
    width: 60%;
    max-width: 180px;
  }

  .gallery-item figcaption {
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .project-category {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-dark);
    margin-bottom: 0.4rem;
  }

  .gallery-item h4 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--navy-deep);
  }

  .project-location {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    color: var(--gray-400);
  }

  .gallery-cta {
    margin-top: 3rem;
    text-align: center;
  }

  .gallery-cta p {
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

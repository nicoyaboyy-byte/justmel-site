---
const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : base + '/';
const g = (name: string) => `${b}images/gallery/${name}`;

const projects = [
  { cat: 'Siding', title: 'Blue Vinyl Cape Re-Side', loc: 'Northern NJ', img: g('siding-01-blue-cape.jpg') },
  { cat: 'Roofing', title: 'Asphalt Shingle + Cedar Shake', loc: 'Northern NJ', img: g('roofing-01-shingle-cedar.jpg') },
  { cat: 'Windows', title: 'Andersen Bay Window Install', loc: 'Northern NJ', img: g('windows-01-andersen-bay.jpg') },
  { cat: 'Gutters', title: 'Seamless Aluminum Gutters', loc: 'Northern NJ', img: g('gutters-01-sage-house.jpg') },
  { cat: 'Siding', title: 'White Colonial Full Re-Side', loc: 'Northern NJ', img: g('siding-02-white-colonial.jpg') },
  { cat: 'Roofing', title: 'Dark Architectural Shingle', loc: 'Northern NJ', img: g('roofing-03-dark-roof.jpg') },
  { cat: 'Windows', title: 'Andersen Double-Hung Window Array', loc: 'Northern NJ', img: g('windows-02-andersen-array.jpg') },
  { cat: 'Gutters', title: 'Gutter + Fascia Rebuild', loc: 'Northern NJ', img: g('gutters-03-install.jpg') },
];
---

<section class="gallery section" id="gallery">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">Our Gallery</span>
      <h2>Recent Work, Real Results</h2>
      <p>
        A small window into the exterior transformations we've delivered across
        northern New Jersey. Ask for project references on your estimate visit.
      </p>
    </div>

    <div class="gallery-grid">
      {projects.map((p, i) => (
        <figure class={`gallery-item reveal reveal-delay-${(i % 4) + 1}`}>
          <div class="gallery-image" style={`background-image: url('${p.img}');`}>
            <div class="gallery-hover">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </div>
          </div>
          <figcaption>
            <span class="proj-cat">{p.cat}</span>
            <h4>{p.title}</h4>
            <span class="proj-loc">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {p.loc}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery {
    background: var(--off-white);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .gallery-item {
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all 0.35s var(--ease-out);
    cursor: pointer;
  }

  .gallery-item:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .gallery-image {
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: transform 0.6s var(--ease-out);
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.04);
  }

  .gallery-hover {
    position: absolute;
    inset: 0;
    background: rgba(10, 18, 40, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    color: var(--white);
  }

  .gallery-hover::after {
    content: '';
    position: absolute;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: rgba(79, 182, 196, 0.2);
    transform: scale(0.7);
    transition: transform 0.3s ease;
  }

  .gallery-hover svg {
    position: relative;
    z-index: 2;
  }

  .gallery-item:hover .gallery-hover {
    opacity: 1;
  }

  .gallery-item:hover .gallery-hover::after {
    transform: scale(1);
  }

  .gallery-item figcaption {
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .proj-cat {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--teal-dark);
    margin-bottom: 0.5rem;
  }

  .gallery-item h4 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--navy-deep);
    line-height: 1.3;
  }

  .proj-loc {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: var(--gray-400);
  }

  @media (max-width: 1000px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 520px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>

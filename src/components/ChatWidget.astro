---
// JustMel AI Chat Widget — powered by Claude
---

<div id="chat-widget" class="chat-widget">
  <!-- Toggle button -->
  <button id="chat-toggle" class="chat-toggle" aria-label="Chat with JustMel assistant" aria-expanded="false">
    <span class="toggle-icon-open">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </span>
    <span class="toggle-icon-close" hidden>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </span>
  </button>

  <!-- Chat panel -->
  <div id="chat-panel" class="chat-panel" hidden aria-live="polite">
    <div class="chat-header">
      <div class="chat-avatar">JM</div>
      <div class="chat-header-text">
        <strong>JustMel Assistant</strong>
        <span>Ask about our services</span>
      </div>
    </div>

    <div id="chat-messages" class="chat-messages">
      <!-- Welcome message injected by JS -->
    </div>

    <form id="chat-form" class="chat-input-area" autocomplete="off">
      <input
        id="chat-input"
        type="text"
        placeholder="Ask about roofing, siding, windows…"
        maxlength="500"
        autocomplete="off"
      />
      <button type="submit" class="send-btn" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  .chat-widget {
    position: fixed;
    bottom: 5.5rem;
    right: 1.5rem;
    z-index: 95;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  /* ---- Toggle button ---- */
  .chat-toggle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--navy-deep);
    color: var(--white);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(10, 18, 40, 0.35);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .chat-toggle:hover {
    background: var(--teal-dark);
    transform: scale(1.08);
  }

  /* ---- Panel ---- */
  .chat-panel {
    width: 340px;
    max-height: 520px;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(10, 18, 40, 0.2), 0 2px 8px rgba(10, 18, 40, 0.08);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform-origin: bottom right;
    animation: panelIn 0.25s var(--ease-out);
  }

  @keyframes panelIn {
    from { opacity: 0; transform: scale(0.92) translateY(12px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* ---- Header ---- */
  .chat-header {
    background: var(--navy-deep);
    color: var(--white);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .chat-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--teal);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .chat-header-text {
    display: flex;
    flex-direction: column;
  }

  .chat-header-text strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .chat-header-text span {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /* ---- Messages ---- */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    scroll-behavior: smooth;
  }

  .chat-messages::-webkit-scrollbar { width: 4px; }
  .chat-messages::-webkit-scrollbar-thumb { background: var(--gray-200); border-radius: 2px; }

  /* Individual message bubbles */
  .msg {
    display: flex;
    flex-direction: column;
    max-width: 85%;
  }

  .msg.user {
    align-self: flex-end;
    align-items: flex-end;
  }

  .msg.bot {
    align-self: flex-start;
    align-items: flex-start;
  }

  .msg-bubble {
    padding: 0.65rem 0.9rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .msg.user .msg-bubble {
    background: var(--navy-deep);
    color: var(--white);
    border-bottom-right-radius: 0.25rem;
  }

  .msg.bot .msg-bubble {
    background: var(--off-white);
    color: var(--ink);
    border-bottom-left-radius: 0.25rem;
    border: 1px solid var(--gray-100);
  }

  /* Typing indicator */
  .typing-bubble {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.75rem 1rem;
  }

  .typing-bubble span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gray-400);
    animation: typingDot 1.2s infinite ease-in-out;
  }

  .typing-bubble span:nth-child(2) { animation-delay: 0.2s; }
  .typing-bubble span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typingDot {
    0%, 80%, 100% { transform: scale(0.75); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* ---- Input area ---- */
  .chat-input-area {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--gray-100);
    flex-shrink: 0;
    background: var(--white);
  }

  #chat-input {
    flex: 1;
    border: 1px solid var(--gray-200);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--off-white);
    outline: none;
    transition: border-color 0.2s ease;
    min-width: 0;
  }

  #chat-input:focus {
    border-color: var(--teal);
    background: var(--white);
  }

  .send-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--teal-dark);
    color: var(--white);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .send-btn:hover {
    background: var(--navy-deep);
    transform: scale(1.08);
  }

  .send-btn:disabled {
    background: var(--gray-300);
    cursor: not-allowed;
    transform: none;
  }

  /* Mobile adjustments */
  @media (max-width: 400px) {
    .chat-widget {
      right: 0.75rem;
      bottom: 5rem;
    }

    .chat-panel {
      width: calc(100vw - 1.5rem);
    }
  }
</style>

<script>
  const CHAT_ENDPOINT = '/.netlify/functions/chat';
  const WELCOME =
    "Hi! I'm the JustMel assistant. Ask me anything about our roofing, siding, windows, or gutter services — or about pricing, timelines, and our service area in northern NJ.";

  const toggleBtn = document.getElementById('chat-toggle') as HTMLButtonElement;
  const panel = document.getElementById('chat-panel') as HTMLDivElement;
  const messagesEl = document.getElementById('chat-messages') as HTMLDivElement;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const iconOpen = toggleBtn.querySelector('.toggle-icon-open') as HTMLElement;
  const iconClose = toggleBtn.querySelector('.toggle-icon-close') as HTMLElement;

  let isOpen = false;
  let isLoading = false;
  let history: { role: 'user' | 'assistant'; content: string }[] = [];
  let welcomeShown = false;

  function openPanel() {
    isOpen = true;
    panel.hidden = false;
    toggleBtn.setAttribute('aria-expanded', 'true');
    iconOpen.hidden = true;
    iconClose.hidden = false;

    if (!welcomeShown) {
      welcomeShown = true;
      appendMessage('bot', WELCOME);
    }

    requestAnimationFrame(() => input.focus());
  }

  function closePanel() {
    isOpen = false;
    panel.hidden = true;
    toggleBtn.setAttribute('aria-expanded', 'false');
    iconOpen.hidden = false;
    iconClose.hidden = true;
  }

  toggleBtn.addEventListener('click', () => {
    if (isOpen) closePanel(); else openPanel();
  });

  function appendMessage(role: 'user' | 'bot', text: string) {
    const msg = document.createElement('div');
    msg.className = `msg ${role}`;

    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble';
    bubble.textContent = text;

    msg.appendChild(bubble);
    messagesEl.appendChild(msg);
    messagesEl.scrollTop = messagesEl.scrollHeight;

    return msg;
  }

  function appendTyping(): HTMLElement {
    const msg = document.createElement('div');
    msg.className = 'msg bot';
    msg.id = 'typing-indicator';

    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble typing-bubble';
    bubble.innerHTML = '<span></span><span></span><span></span>';

    msg.appendChild(bubble);
    messagesEl.appendChild(msg);
    messagesEl.scrollTop = messagesEl.scrollHeight;

    return msg;
  }

  function removeTyping() {
    document.getElementById('typing-indicator')?.remove();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const text = input.value.trim();
    if (!text || isLoading) return;

    input.value = '';
    isLoading = true;
    const sendBtn = form.querySelector('.send-btn') as HTMLButtonElement;
    sendBtn.disabled = true;

    appendMessage('user', text);
    history.push({ role: 'user', content: text });

    const typingEl = appendTyping();

    try {
      const res = await fetch(CHAT_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      const data = await res.json();

      typingEl.remove();

      if (data.content) {
        appendMessage('bot', data.content);
        history.push({ role: 'assistant', content: data.content });
      } else {
        appendMessage('bot', data.error || 'Sorry, something went wrong. Please call us at 973-698-0608.');
      }
    } catch {
      typingEl.remove();
      appendMessage('bot', "Couldn't connect right now. Give us a call at 973-698-0608 — we're here Mon–Sat, 7am–6pm.");
    } finally {
      isLoading = false;
      sendBtn.disabled = false;
      input.focus();
    }
  });
</script>
